[Desktop Entry]
Type=Application
Name=Start Simulator
Comment=Start the PAC Simulator (relaunches it if already running)
# Replace __INSTALL_DIR__ with your actual repo path before use.
# The pi_setup/README.md install instructions include a one-line sed
# command that does this for you.
Exec=__INSTALL_DIR__/pi_setup/start_pac.sh
Icon=__INSTALL_DIR__/pi_setup/start_icon.png
Terminal=false
Categories=Education;Science;
